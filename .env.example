DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Seconds after the tool starts until the booking is written
COMMIT_AT=3.0
# Seconds after the tool starts until the tool returns
TOTAL=6.0
# --turn fast: seconds of silence after VAD reports the user stopped, before the
# turn closes (SpeechTimeoutUserTurnStopStrategy user_speech_timeout).
# 0.2 closes the turn on a 0.22 s dip inside "Friday, ummm" (tasks.md, run 3). 0.4 bridges it
TURN_FAST_TIMEOUT=0.4
# Pipecat's own log level. The timeline prints regardless. Use DEBUG to see LLM requests and connections
LOG_LEVEL=WARNING
